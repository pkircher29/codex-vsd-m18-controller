# VSDinside / Mirabox M18 Stream Dock permissions.
# Keep this rule before 73-seat-late.rules so TAG+="uaccess" is applied to the active desktop seat.

SUBSYSTEM=="usb", ATTRS{idVendor}=="5548", ATTRS{idProduct}=="1000", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="5548", ATTRS{idProduct}=="1000", MODE="0660", TAG+="uaccess"

SUBSYSTEM=="usb", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1009", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1009", MODE="0660", TAG+="uaccess"

SUBSYSTEM=="usb", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1012", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1012", MODE="0660", TAG+="uaccess"
